# Copy to .env beside spike_tests.py, or export these in your shell.
# NEVER put real keys in any other file. The tests never print key values.

# Local Supabase stack — `supabase start` / `supabase status` prints these.
# NOTE: this repo's supabase/config.toml uses the 544xx port block (another
# local project owns the defaults), so the API URL here is port 54421.
# On a stock setup it would be http://127.0.0.1:54321 — trust `supabase status`.
SPIKE_SUPABASE_URL=http://127.0.0.1:54421
# The "secret" key of the LOCAL stack (legacy name: service_role key).
SPIKE_SUPABASE_SERVICE_KEY=
# The "publishable" key of the LOCAL stack (legacy name: anon key).
SPIKE_SUPABASE_ANON_KEY=

# Remote targets are BLOCKED by default (the spike only runs locally).
# To point at a remote project you must set BOTH:
# SPIKE_ALLOW_REMOTE=1
# SPIKE_PROJECT_REF=your-project-ref-here
